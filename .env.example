# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example (for Render):
# DATABASE_URL="postgresql://user:password@hostname:5432/campusfix?sslmode=require"

# JWT Authentication
# In development, a default key is available for local testing.
# In production (NODE_ENV=production), JWT_SECRET is STRICTLY REQUIRED. The application will refuse to start if omitted.
JWT_SECRET="campusfix_jwt_secure_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# CORS / Client URL
CLIENT_URL="http://localhost:5173"

# Admin Seed Account (Used during initial seeding)
ADMIN_EMAIL="admin@campusfix.edu"
ADMIN_PASSWORD="Admin@CampusFix2026"
ADMIN_NAME="Campus Facilities Administrator"
