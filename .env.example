# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example (for Render):
# DATABASE_URL="postgresql://user:password@hostname:5432/sportsync?sslmode=require"

# JWT Authentication
JWT_SECRET="sportsync_jwt_secure_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# CORS / Client URL
CLIENT_URL="http://localhost:5173"

# Admin Seed Account (Used during initial seeding)
ADMIN_EMAIL="admin@sportsync.local"
ADMIN_PASSWORD="Admin@sportsync2026"
ADMIN_NAME="Administrator"
